{
  "name": "Bug tracker",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y chromium chromium-driver sqlite3 && pip install -r requirements.txt",
  "containerEnv": {
    "CHROME_BIN": "/usr/bin/chromium",
    "CHROMEDRIVER_PATH": "/usr/bin/chromedriver"
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": { "label": "Bug tracker", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
